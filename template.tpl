// Enter your template code here.
const log = require('logToConsole');
const setInWindow = require('setInWindow');
const copyFromWindow = require('copyFromWindow');
const callInWindow = require('callInWindow');
const callLater = require('callLater');
const copyFromDataLayer = require('copyFromDataLayer');
const JSON = require('JSON');


log('data =', data);

const configObject = {};

/* CUSTOMIZATION OPTIONS START */
if (data.language) {
  configObject.customizationOptions = configObject.customizationOptions || {};
  configObject.customizationOptions.defaultLanguage = data.language;
}
if (data.websiteLogoUrl) {
  configObject.customizationOptions = configObject.customizationOptions || {};
  configObject.customizationOptions.websiteLogoUrl = data.websiteLogoUrl;
}
if (data.contentTextColor) {
  configObject.customizationOptions = configObject.customizationOptions || {};
  configObject.customizationOptions.contentTextColor = data.contentTextColor;
}
if (data.btnBodyColor) {
  configObject.customizationOptions = configObject.customizationOptions || {};
  configObject.customizationOptions.buttons =
    configObject.customizationOptions.buttons || {};
  configObject.customizationOptions.buttons.bodyColor = data.btnBodyColor;
}
if (data.btnTextColor) {
  configObject.customizationOptions = configObject.customizationOptions || {};
  configObject.customizationOptions.buttons =
    configObject.customizationOptions.buttons || {};
  configObject.customizationOptions.buttons.textColor = data.btnTextColor;
}
if (data.btnRadius) {
  configObject.customizationOptions = configObject.customizationOptions || {};
  configObject.customizationOptions.buttons =
    configObject.customizationOptions.buttons || {};
  configObject.customizationOptions.buttons.radius = data.btnRadius;
}

if (data.linkColor) {
  configObject.customizationOptions = configObject.customizationOptions || {};
  configObject.customizationOptions.hyperlinks =
    configObject.customizationOptions.hyperlinks || {};
  configObject.customizationOptions.hyperlinks.color = data.linkColor;
}
if (data.linkColorOnHover) {
  configObject.customizationOptions = configObject.customizationOptions || {};
  configObject.customizationOptions.hyperlinks =
    configObject.customizationOptions.hyperlinks || {};
  configObject.customizationOptions.hyperlinks.colorOnHover =
    data.linkColorOnHover;
}
if (data.linkIsUnderlined) {
  configObject.customizationOptions = configObject.customizationOptions || {};
  configObject.customizationOptions.hyperlinks =
    configObject.customizationOptions.hyperlinks || {};
  configObject.customizationOptions.hyperlinks.isUnderlined =
    data.linkIsUnderlined;
}
/* CUSTOMIZATION OPTIONS END */

/* INTEGRATIONS START */
if (data.disableGoogleSecureSignals) {
  configObject.integrations = {};
  configObject.integrations.disableGoogleSecureSignals =
    data.disableGoogleSecureSignals;
}
/* INTEGRATIONS END */

/* INDEPENDENT CONFIG START */
if (data.logLevelOptions) {
  configObject.logLevel = data.logLevelOptions;
}
if (data.customUtiqHost) {
  configObject.customUtiqHost = data.customUtiqHost;
}
if (data.consentManagerOrigin) {
  configObject.consentManagerOrigin = data.consentManagerOrigin;
}
if (data.variation) {
  configObject.variation = data.variation;
}
/* INDEPENDENT CONFIG END */

/* CMP START */
if (data.model === 'Integrated') {
  configObject.CMP = 'none';
  const utiqPurposeId = data.UtiqPurposeId;
  const utiqVendorId = data.UtiqVendorId;


  const updateCMPConsentHandling = (updateConsentFunction) => {
    //Change CMP consent based on Utiq consent
    const getUtiqConsentStatus = copyFromWindow(
      'Utiq.API.getUtiqConsentStatus'
    );
    if (getUtiqConsentStatus) {
      updateConsentFunction(getUtiqConsentStatus(), true);
    } else {
      log(
        'console.error',
        'getUtiqConsentStatus API call failed or returned invalid value.'
      );
    }

    //Event listener to be trigered when Utiq consent change
    callInWindow(
      'Utiq.API.addEventListener',
      'onConsentUpdateFinished',
      function (consent) {
        //Change CMP consent based on Utiq consent
        updateConsentFunction(consent.isConsentGranted);
      }
    );
  };  

  // Initialize required namespaces using setInWindow/getInWindow
  setInWindow('Utiq', copyFromWindow('Utiq') || {});
  setInWindow('Utiq.queue', copyFromWindow('Utiq.queue') || []);
  setInWindow('Utiq.API', copyFromWindow('Utiq.API') || {});
  
  switch (data.cmpName) {
    case 'Didomi':
      {
        log('START Didomi Agnostic');
        const isConsentGranted = (Didomi) => {
          if (!Didomi) return undefined; // Safeguard if Didomi isn't available
          const currentUserStatus = Didomi.getCurrentUserStatus();
          const purposeConsent = currentUserStatus.purposes[utiqPurposeId.replace('c:', '')].enabled;
          const vendorConsent = currentUserStatus.vendors[utiqVendorId.replace('c:', '')].enabled;
  

          if (Didomi.shouldUserStatusBeCollected()) {
            return undefined;
          }
          if (purposeConsent === false && vendorConsent === false) {
            return false;
          } else if (purposeConsent === true && vendorConsent !== false) {
            return true;
          }
          return false;
        };

        const updateConsent = (Didomi, consent, isFirstCall) => {
          const didomiIsCmpConsentGranted = isConsentGranted(Didomi);
          if (consent === false && didomiIsCmpConsentGranted === true) {
            const status = Didomi.getCurrentUserStatus();
            const newStatus = {
              purposes: status.purposes,
              vendors: status.vendors
            };
            newStatus.purposes[utiqPurposeId] = {
              id: utiqPurposeId,
              enabled: false
            };
            newStatus.vendors[utiqVendorId.replace('c:', '')] = {
              id: utiqVendorId.replace('c:', ''),
              enabled: false
            };
            Didomi.setCurrentUserStatus(newStatus);
          } else if (consent === true && didomiIsCmpConsentGranted !== true) {
            if (isFirstCall) {
              callInWindow('Utiq.API.handleConsentChange', false, { clearConsent: true });
            } else {
              const status = Didomi.getCurrentUserStatus();
              const newStatus = {
                purposes: status.purposes,
                vendors: status.vendors
              };
              newStatus.purposes[utiqPurposeId] = {
                id: utiqPurposeId,
                enabled: true
              };
              newStatus.vendors[utiqVendorId.replace('c:', '')] = {
                id: utiqVendorId.replace('c:', ''),
                enabled: true
              };
              Didomi.setCurrentUserStatus(newStatus);
            }
          } else if (consent === undefined && didomiIsCmpConsentGranted !== undefined) {
            callInWindow('Utiq.API.handleConsentChange', didomiIsCmpConsentGranted);
          }
        };

        // Initialize required namespaces using setInWindow/getInWindow
        setInWindow('didomiOnReady', copyFromWindow('didomiOnReady') || []);
        setInWindow('didomiEventListeners', copyFromWindow('didomiEventListeners') || []);

        // Push to didomiOnReady using callInWindow to invoke the push method
        callInWindow('didomiOnReady.push', function (Didomi) {
          // Push event listener to didomiEventListeners
          callInWindow('didomiEventListeners.push', {
            event: 'consent.changed',
            listener: function (context) {
              callInWindow('Utiq.queue.push', function () {
                const didomiConsent = isConsentGranted(Didomi);
                if (context.action === 'click' && didomiConsent) {
                  callInWindow('Utiq.API.handleConsentChange', didomiConsent, {
                    syncConsentOnAccept: true, // syncConsentOnAccept flag should be only set to true when the         consent is explicitly accepted
                  });
                } else {
                  callInWindow('Utiq.API.handleConsentChange', didomiConsent);
                }
              });
            },
          });

          // Push another function to Utiq.queue
          callInWindow('Utiq.queue.push', function () {
            updateCMPConsentHandling((isConsentGranted, isFirstCall) => updateConsent(Didomi, isConsentGranted, isFirstCall));
          });
        });
        log('END Didomi Agnostic');
      }
      break;
    case 'Optanon':
      {
        log('START Optanon Agnostic');
        const waitForOptanon = (
          action
        ) => {
          let interval = 1;
          let wasCalled = false;
          const iteration = () => {
            if (typeof copyFromWindow('Optanon.OnConsentChanged') !== 'function') {
              interval = (interval + 1) * (1.2);
              callLater(iteration, interval);
            } else if (!wasCalled){
              wasCalled = true;
              log('OPTANON FOUND');
              callLater(action,250);              
            }
            return;
          };
          iteration();
        };
        
        const isUserConsentGranted = () => {
          const optanon = copyFromWindow('Optanon');
          if (!optanon.IsAlertBoxClosed()) {
            return undefined;
          }
          const activeGroups = copyFromWindow('OptanonActiveGroups');
          if (typeof activeGroups !== 'string' || activeGroups === '') {
            return undefined;
          }
          return (
            activeGroups.indexOf(utiqPurposeId) !== -1 &&
            activeGroups.indexOf(utiqVendorId) !== -1
          );
        };

        const updateConsent = (isUtiqConsentGranted, isFirstCall) => {
          const optanonIsCmpConsentGranted = isUserConsentGranted();
          const Optanon = copyFromWindow('Optanon');
          if (isUtiqConsentGranted === false && optanonIsCmpConsentGranted === true) {
            Optanon.UpdateConsent('Category', utiqPurposeId + ':0');
            Optanon.UpdateConsent('General Vendor', utiqVendorId + ':0');
          } else if (
            isUtiqConsentGranted === true &&
            optanonIsCmpConsentGranted !== true
          ) {              
            if (isFirstCall) {
              callInWindow('Utiq.API.handleConsentChange', false, { clearConsent: true });
            } else {
              Optanon.UpdateConsent('Category', utiqPurposeId + ':1');
              Optanon.UpdateConsent('General Vendor', utiqVendorId + ':1');
            }
          } else if (
            isUtiqConsentGranted === undefined &&
            optanonIsCmpConsentGranted !== undefined
          ) {
            callInWindow('Utiq.API.handleConsentChange', optanonIsCmpConsentGranted);
          }
        };

        waitForOptanon(() => {
          // Push to Utiq.queue
          callInWindow('Utiq.queue.push', function () {
            callInWindow('Optanon.OnConsentChanged',() => {
              log('Running Optanon newMethod');
              const optanonConsent = isUserConsentGranted();
              const utiqConsentStatus = callInWindow('Utiq.API.getUtiqConsentStatus');
              if (utiqConsentStatus === undefined || optanonConsent !== undefined) {
                callInWindow('Utiq.API.handleConsentChange', optanonConsent, {
                  syncConsentOnAccept: !!optanonConsent, // syncConsentOnAccept flag should be only set to true                 when the consent is explicitly accepted
                });
              }
            });
          
            updateCMPConsentHandling(updateConsent);
          });
        });
        
        log('END Optanon Agnostic');
      }
      break;
    case 'Iubenda':
      {
        log('START Iubenda Agnostic');
        // Initialize _iub if not present
        setInWindow('_iub', copyFromWindow('_iub') || {});  

        let isFirstLoad = true;

        const isConsentGranted = () => {
          const preferences = callInWindow('_iub.cs.api.getPreferences');
          if (preferences == null) return undefined; // Fixed: assuming check for null/undefined
          return (
            preferences.purposes && 
            typeof preferences.purposes[utiqPurposeId] === 'boolean'
          ) ? preferences.purposes[utiqPurposeId]
            : undefined;
        };
        
        const updateConsent = (consent, isFirstCall) => {
          const iubendaIsCmpConsentGranted = isConsentGranted();
          callLater(() => {
            const purposes = {};
            if (consent === false && iubendaIsCmpConsentGranted === true) {
              purposes[utiqPurposeId] = false;
              callInWindow('_iub.cs.api.setPreferences', { purposes: purposes });
            } else if (consent === true && iubendaIsCmpConsentGranted !== true) {
              if (isFirstCall) {
                callInWindow('Utiq.API.handleConsentChange', false, { clearConsent: true });
              } else {
                purposes[utiqPurposeId] = true;
                callInWindow('_iub.cs.api.setPreferences', { purposes: purposes });
              }
            } else if (
              consent === undefined &&
              iubendaIsCmpConsentGranted !== undefined
            ) {
              callInWindow('Utiq.API.handleConsentChange', iubendaIsCmpConsentGranted);
            }
            if (isFirstLoad) {
              callInWindow('_iub.cs.on', 'callback.before.onPreferenceExpressed', (context) => {
                if (!isFirstLoad) {
                  callInWindow('Utiq.queue.push', function () {
                    callInWindow(
                      'Utiq.API.handleConsentChange', isConsentGranted() === true, {
                        syncConsentOnAccept: !!context.gppString, // syncConsentOnAccept flag should be only set         to true when the consent is explicitly accepted
                      }
                    );
                  });
                }
              });
            }
            isFirstLoad = false;
          }, 250);
        };

        callLater(() => {
          callInWindow('Utiq.queue.push', function () {
            if (copyFromWindow('_iub.csReady')) {
              updateCMPConsentHandling(updateConsent);                
            } else {      
              callInWindow(
                '_iub.cs.on', 
                'callback.before.onReady',
                () => updateCMPConsentHandling(updateConsent));
            }
          });
        }, 250);
        log('END Iubenda Agnostic');
      }
      break;
      
    case 'SourcePoint':
      setInWindow('_utiqPurposeId', utiqPurposeId);
      setInWindow('_utiqVendorId', utiqVendorId);
      log('IDS: ', copyFromWindow('_utiqPurposeId'), copyFromWindow('_utiqVendorId'));
      break;
    case 'Usercentrics':
      setInWindow('_utiqServiceName', data.UtiqServiceName);
      log('Service Name: ', copyFromWindow('_utiqServiceName'));
      break;
    default:
      break;
  }
}
/* CMP END */
log('configObject: ', configObject);
setInWindow('Utiq.config', configObject);
log(copyFromWindow('Utiq'));

// Call data.gtmOnSuccess when the tag is finished.
data.gtmOnSuccess();


