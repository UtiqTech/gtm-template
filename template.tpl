ed);           });         });       } else if (ucApiHandler.hasUiApi()) {         return new Promise(function (resolve, reject) {           var info \u003d window.UC_UI.getServicesBaseInfo();           var service \u003d info.find(function (service) {             return service.name \u003d\u003d\u003d UTIQ_SERVICE_NAME;           });           resolve(service ? service.consent : undefined);         });       } else {         return undefined;       }     } catch (err) {       console.error(\u0027getServiceId failed:\u0027, err);       return undefined;     }   }, getConsentStatus: function () {     try {       return new Promise(function (resolve, reject) {         ucApiHandler.getConsentInfo().then(function (consentInfo) {           if (ucApiHandler.hasCmpV3()) {             resolve(consentInfo \u0026\u0026 consentInfo.type.toUpperCase() \u003d\u003d\u003d \u0027EXPLICIT\u0027 ? consentInfo.given : undefined);           } else if (ucApiHandler.hasUiApi()) {             var consentHistory \u003d consentInfo \u0026\u0026 consentInfo.history ? consentInfo.history[consentInfo.history.length - 1] : undefined;             resolve(consentHistory \u0026\u0026 consentHistory.type.toUpperCase() \u003d\u003d\u003d \u0027EXPLICIT\u0027 ? consentHistory.status : undefined);           } else {             resolve(undefined);           }         });       });     } catch (err) {       console.error(\u0027getConsentStatus failed:\u0027, err);       return undefined;     }   }, updateConsent: function (newConsentValue) {     try {       return new Promise(function (resolve, reject) {         ucApiHandler.getServiceInfo().then(function (info) {           if (info) {             var serviceId \u003d info.id;             if (ucApiHandler.hasCmpV3()) {               window.__ucCmp.updateServicesConsents([{ id: serviceId, consent: newConsentValue }]).then(function () {                 window.__ucCmp.saveConsents();                 resolve();               });             } else if (ucApiHandler.hasUiApi()) {               if (newConsentValue \u003d\u003d\u003d false) {                 window.UC_UI.rejectService(serviceId).then(resolve);               } else if (newConsentValue \u003d\u003d\u003d true) {                 window.UC_UI.acceptService(serviceId).then(resolve);               }             } else {               throw Error(\u0027Neither V2 nor V2 usercentrics APIs were available when updating the consent\u0027);             }           }         });       });     } catch (err) {       console.error(\u0027updateConsent failed:\u0027, err);     }   } };  function updateConsent(newConsentValue, isFirstCall) {   ucApiHandler.getConsentStatus().then(function (cmpConsentGranted) {     if (newConsentValue \u003d\u003d\u003d undefined \u0026\u0026 cmpConsentGranted !\u003d\u003d undefined) {       try {         window.Utiq.API.handleConsentChange(!!cmpConsentGranted);       } catch (err) {         console.error(\u0027handleConsentChange failed: \u0027 + err.message);       }       isFirstLoad \u003d false;       return;     } else if (newConsentValue !\u003d\u003d cmpConsentGranted) {       if (isFirstCall \u0026\u0026 newConsentValue \u003d\u003d\u003d true) {         window.Utiq.API.handleConsentChange(false, { clearConsent: true });         isFirstLoad \u003d false;       } else if (cmpConsentGranted \u003d\u003d\u003d true || cmpConsentGranted \u003d\u003d\u003d false) {         try {           ucApiHandler.updateConsent(newConsentValue);         } catch (err) {           console.error(\u0027Error updating Usercentrics consent:\u0027, err);         } finally {           isFirstLoad \u003d false;         }       }       return;     }     isFirstLoad \u003d false;   }); }  window.addEventListener(\u0027ucEvent\u0027, function (e) {   if (e.detail \u0026\u0026 e.detail.event \u003d\u003d\u003d \u0027consent_status\u0027) { /* Avoid interatcion on first load */     if (e.detail.action \u003d\u003d\u003d \u0027onInitialPageLoad\u0027 || isFirstL